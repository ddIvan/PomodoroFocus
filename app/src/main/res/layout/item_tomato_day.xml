<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="4dp"
    android:paddingTop="14dp"
    android:paddingEnd="4dp"
    android:paddingBottom="6dp">

    <TextView
        android:id="@+id/tvDayTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:textColor="@color/pomo_text"
        android:textSize="13sp"
        android:textStyle="bold"
        tools:text="10月27日 星期二" />

    <TextView
        android:id="@+id/tvDayCount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_tag_primary"
        android:paddingStart="8dp"
        android:paddingTop="2dp"
        android:paddingEnd="8dp"
        android:paddingBottom="2dp"
        android:textColor="@color/pomo_primary"
        android:textSize="11sp"
        tools:text="2 个番茄 · 50 分钟" />
</LinearLayout>
